DJANGO_SECRET_KEY=ctms-dev-secret-key-change-in-production-random-hash
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.*

# Shared database: the CSM's MySQL database
DB_NAME=default
DB_USER=mysql
DB_PASSWORD=
DB_HOST=10.6.8.96
DB_PORT=3311

# Optional dev fallback: Set to True if local MySQL is not running yet
USE_SQLITE_DEV=False

# Where the CTMS itself is reached (check-in QR codes encode this)
CTMS_BASE_URL=http://localhost:5174

# The CSM's public origin (survey links) = the CSM's SURVEY_BASE_URL
CSM_SURVEY_BASE_URL=http://localhost:5173
# Address of the CSM that clients' "Rate Our Service" button opens (defaults to http://csm.dolero3.lan)
CSM_SURVEY_PUBLIC_URL=http://csm.dolero3.lan

CHECKIN_THROTTLE_RATE=10/min
LOGIN_THROTTLE_RATE=5/min
